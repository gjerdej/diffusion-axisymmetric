set mesh type = rectangular

subsection Rectangular mesh
  set x size = 100
  set y size = 100
  set z size = 100
end

set global refinement = 7
set max refinement = 7
set min refinement = 2
set mesh adaptivity = false
set remeshing period = 1000

subsection refinement criterion: 0
  set variables                      = c
  set type                           = value
  set value lower bound              = 0.01
  set value upper bound              = 0.99
end

set time step = 4.0
set number steps = 300

subsection output
  set condition = EQUAL_SPACING
  set number = 20
end

set Model constant D = 1.0, DOUBLE
set Model constant c0 = 1.0, DOUBLE
set Model constant A = 0.1, DOUBLE

subsection linear solver parameters: 0
  set solver_ids               = 0
  set solver type              = bicgstab
  set max iterations           = 10000
  set tolerance type           = RMSEPerField
  set tolerance value          = 1.0e-6
end

subsection boundary conditions: 0
  set variables = c
  set conditions = Natural, Natural, Natural, Natural
end
